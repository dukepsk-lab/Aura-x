# ─────────────────────────────────────────────────────────────────────────────
# Aura-X environment configuration (copy to `.env`, never commit the real file)
# All variables are prefixed AURAX_ and consumed by aurax.config.Settings.
# ─────────────────────────────────────────────────────────────────────────────

# --- Runtime ---
AURAX_ENV=dev                       # dev | staging | live
AURAX_LOG_LEVEL=INFO

# --- TimescaleDB (Layer 0 single source of truth) ---
AURAX_DB__HOST=localhost
AURAX_DB__PORT=5432
AURAX_DB__NAME=aurax
AURAX_DB__USER=aurax
AURAX_DB__PASSWORD=change-me
AURAX_DB__SCHEMA=market

# --- MT5 broker connection (Layer 0 ingestion / Layer 7 execution) ---
AURAX_MT5__LOGIN=00000000
AURAX_MT5__PASSWORD=change-me
AURAX_MT5__SERVER=YourBroker-Demo
AURAX_MT5__TERMINAL_PATH=

# --- Telegram monitoring (Layer 8) ---
AURAX_TELEGRAM__BOT_TOKEN=
AURAX_TELEGRAM__CHAT_ID=

# --- API (FastAPI) ---
AURAX_API__HOST=0.0.0.0
AURAX_API__PORT=8000
